<root>
   <name>{{xml_name}}</name>
   <key>{{key}}</key>
   <state>stable</state>
   <logo>{{repo}}/raw/main/docs/logo.png</logo>
   <description>
      <short>
         <en>{{xml_description}}</en>
      </short>
      <long>
         <en><![CDATA[
{{description}}
         ]]></en>
      </long>
   </description>
   <homepage>{{repo}}</homepage>
   <download>{{repo}}/releases</download>
   <issues>{{repo}}/issues</issues>
   <readme>{{repo}}/blob/main/README.md</readme>
   <authors>
      <author>{{xml_author}}</author>
   </authors>
   <versions>
{{#if glpi12}}
      <version>
         <num>0.1.0</num>
         <compatibility>~12.0</compatibility>
         <download_url>{{repo}}/releases/download/v0.1.0/{{key}}-0.1.0.tgz</download_url>
      </version>
{{/if}}
{{#if glpi11}}
      <version>
         <num>0.1.0</num>
         <compatibility>~11.0</compatibility>
         <download_url>{{repo}}/releases/download/v0.1.0/{{key}}-0.1.0.tgz</download_url>
      </version>
{{/if}}
   </versions>
   <langs>
      <lang>en_GB</lang>
   </langs>
   <license>{{licenseShort}}</license>
   <tags>
      <en>
         <tag>{{key}}</tag>
      </en>
   </tags>
</root>
